# ============================================
# Turso Service - Production Configuration
# ============================================
# Copy this to .env and fill in your values

# Server
BIND_ADDRESS=0.0.0.0:3000

# Data Storage (absolute path recommended for production)
DATA_DIR=D:/turso-service/data

# Authentication
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRY_HOURS=24

# Database Limits
MAX_DATABASES=100
MAX_QUERIES_PER_MINUTE=60

# Logging
RUST_LOG=turso_service=info,tower_http=info

# Encryption (optional, experimental)
# ENCRYPTION_KEY=your-32-byte-encryption-key-here
