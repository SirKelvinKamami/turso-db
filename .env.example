# ============================================
# Turso Service - Production Configuration
# ============================================
# Copy this to .env and fill in your values
# NEVER commit the real .env to the repository

# Server
BIND_ADDRESS=0.0.0.0:3000

# Data Storage (absolute path recommended for production)
DATA_DIR=D:/turso-service/data

# Authentication
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRY_HOURS=24

# Admin account (must be set; start.ps1/DEPLOY.md read these)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Optional bootstrap client users: user1:pass1,user2:pass2
SEED_USERS=

# Optional: verify Google sign-in (dashboard shows Google button only when set)
GOOGLE_CLIENT_ID=

# Database Limits
MAX_DATABASES=100
MAX_QUERIES_PER_MINUTE=60

# Analytics retention (hours) - default 168 (7 days)
ANALYTICS_RETENTION_HOURS=168

# Optional persistence backend (users, db backups, analytics)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# Logging
RUST_LOG=turso_service=info,tower_http=info

# Encryption (optional, experimental)
# ENCRYPTION_KEY=your-32-byte-encryption-key-here

# LibSQL replica sync (optional; OFF by default)
# SYNC_ENABLED=false
# Hub base URL: libsql://host / turso://host / https://host
# SYNC_HUB_URL=
# Hub auth token (leave empty for tokenless hubs)
# SYNC_HUB_TOKEN=
# Replica poll interval ms (default 5000, clamped to >= 250)
# SYNC_POLL_MS=5000