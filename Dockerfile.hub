# Self-hosted Turso-style sync hub built from src/bin/sync_hub.rs.
#
# The hub speaks the turso-sync-engine wire protocol (POST /v2/pipeline and
# POST /pull-updates) that sqld's REST layer no longer serves, so replicas
# running turso-service can converge through it.
FROM rust:1.97 as builder
RUN apt-get update && apt-get install -y gcc g++ make cmake pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN cargo build --release --bin sync_hub

# Runtime must match (or exceed) the glibc the builder image links against;
# trixie-slim ships glibc 2.41.
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/sync_hub .
EXPOSE 10000
# Render injects $PORT; serve the hub through it.
CMD ["sh", "-c", "export HUB_LISTEN=0.0.0.0:${PORT:-10000}; exec ./sync_hub"]